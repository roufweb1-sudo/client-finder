# Keep one line ending everywhere, so a file saved on Windows doesn't show up
# as "every line changed" in git. Text files are stored with LF in the repo.
* text=auto eol=lf

# Binary files git must never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
